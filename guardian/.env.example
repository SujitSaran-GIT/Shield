# Inject these through your deployment secret manager. Spring does not load .env automatically.
DB_URL=jdbc:postgresql://localhost:5432/guardian
DB_USERNAME=shield
DB_PASSWORD=replace-with-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
APP_BOOTSTRAP_SECRET=replace-with-a-separate-high-entropy-one-time-secret
APP_CLIENT_ADMIN_PUBLIC_ENABLED=false
CORS_ALLOWED_ORIGINS=https://console.example.com
COOKIE_SECURE=true
TRUSTED_PROXIES=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-redis-password
RATE_LIMIT_MODE=redis
RATE_LIMIT_OUTAGE_POLICY=fail-closed
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=shield@example.com
SMTP_AUTH=true
SMTP_STARTTLS=true
GEOIP_DB_PATH=/geoip/GeoLite2-City.mmdb
AUDIT_RETENTION_DAYS=90
LOCATION_RETENTION_DAYS=30
# Existing databases: rehearse migrations and back up before enabling once.
DB_BASELINE_ON_MIGRATE=false
# During the encrypted legacy client-key migration only, provide the OLD signing key.
LEGACY_ENCRYPTION_KEY=
